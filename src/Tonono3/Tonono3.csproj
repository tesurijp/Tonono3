<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <ApplicationIcon>TONONO.ICO</ApplicationIcon>
    <ResDir>resources\</ResDir>
    <NativeAotPublishDir>$(MSBuildThisFileDirectory)..\..\publish\</NativeAotPublishDir>
    <Version>1.2.1</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'NativeAot'">
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishDir>$(NativeAotPublishDir)</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tonono3.SkkEngine\Tonono3.SkkEngine.fsproj" />
    <ProjectReference Include="..\Tonono3.Interop\Tonono3.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="tsr-di" Version="1.*" />
    <PackageReference Include="VYaml" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="TONONO.ICO" />
  </ItemGroup>

  <ItemGroup>
    <FilesToDownload Include="SKK-JISYO.L.gz" />
    <FilesToDownload Include="SKK-JISYO.jinmei.gz" />
  </ItemGroup>

  <Target Name="DownloadRequiredFiles" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <BaseUrl>https://skk-dev.github.io/dict/</BaseUrl>
    </PropertyGroup>
    <DownloadFile SourceUrl="$(BaseUrl)%(FilesToDownload.Identity)" DestinationFolder="$(ResDir)" Condition="!Exists('$(ResDir)%(FilesToDownload.Identity)')" />
  </Target>

  <Target Name="RemoveDownloadFiles" AfterTargets="Clean">
    <ItemGroup>
      <FilesToClean Include="$(ResDir)%(FilesToDownload.Identity)" />
    </ItemGroup>
     <Delete Files="@(FilesToClean)" />
  </Target>

  <Target Name="RemoveNativeAotPublish" AfterTargets="Clean">
    <RemoveDir Directories="$(NativeAotPublishDir)" Condition="Exists('$(NativeAotPublishDir)')" />
  </Target>

  <Target Name="CopyResourcesToOutput" AfterTargets="Build">
    <ItemGroup>
      <FilesNeedCopy Include="$(ResDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FilesNeedCopy)" DestinationFiles="@(FilesNeedCopy->'$(OutputPath)\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
