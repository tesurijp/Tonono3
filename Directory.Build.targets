<Project>
    <Target Name="GenerateVersionClass" BeforeTargets="BeforeCompile">
        <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'" >
            <GeneratedVersionFilePath >$(IntermediateOutputPath)GeneratedVersion.fs</GeneratedVersionFilePath>
            <GeneratedVersionCode>
// &lt;auto-generated /&gt;
namespace $(MSBuildProjectName)
module BuildInfo = [&lt;Literal&gt;] let Version = &quot;$(Version)&quot;
            </GeneratedVersionCode>
        </PropertyGroup>

        <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'" >
            <GeneratedVersionFilePath >$(IntermediateOutputPath)GeneratedVersion.cs</GeneratedVersionFilePath>
            <GeneratedVersionCode>
// &lt;auto-generated /&gt;
namespace $(MSBuildProjectName) %3b
public static class BuildInfo { public const string Version = &quot;$(Version)&quot; %3b }
            </GeneratedVersionCode>
        </PropertyGroup>

        <WriteLinesToFile File="$(GeneratedVersionFilePath)" Lines="$(GeneratedVersionCode)" Overwrite="true" WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <Compile Include="$(GeneratedVersionFilePath)" />
        </ItemGroup>
    </Target>
</Project>
